{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": ".tools-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "tools/**/*.ts",
    "src/model/**/*.ts"
  ]
}
